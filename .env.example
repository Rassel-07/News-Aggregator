# ==========================================
# News Aggregator Environment Configuration
# (Zero Database Setup Required)
# ==========================================

# Backend Server
PORT=5001
NODE_ENV=development
JWT_SECRET=aura_news_jwt_secret_development_key_2026

# Client / CORS
FRONTEND_URL=http://localhost:3000

# ==========================================
# Free News API Providers (Optional)
# The application automatically fetches live news from public RSS feeds
# and the Hacker News API out of the box with zero API keys required!
# ==========================================

# Newsdata.io (Free plan: 200 requests/day -> https://newsdata.io)
NEWSDATA_API_KEY=

# NewsAPI.org (Free developer key: 100 requests/day -> https://newsapi.org)
NEWS_API_KEY=

# MediaStack (Free tier: 500 requests/month -> https://mediastack.com)
MEDIASTACK_API_KEY=

# Currents API (Free tier: 600 requests/day -> https://currentsapi.services)
CURRENTS_API_KEY=
